meta {
  name: Health Check
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/integrations/health
  body: none
  auth: none
}

headers {
  Accept: application/json
}

assert {
  res.status: eq 200
  res.body.status: eq ok
}

docs {
  Returns 200 with `{"status":"ok"}` when the integration hub is healthy.
}
