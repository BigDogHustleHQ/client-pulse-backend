# Keep npm's default advisory behavior for the `engines` field: a dependency
# declaring an incompatible Node range produces a warning, not a hard failure.
# Without this, `npm ci` on Node 24 / npm 11 aborts with EBADENGINE on a
# transitive dependency, which fails every CI job. The packages run fine on the
# Node version pinned in .nvmrc.
engine-strict=false
